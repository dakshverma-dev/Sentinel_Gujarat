DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_PASSWORD=sentinel
JWT_SECRET=change-this-before-exposing-the-app
DEMO_USER=operator
DEMO_PASSWORD=sentinel-demo
ADMIN_USER=admin
ADMIN_PASSWORD=sentinel-admin
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=sentinel-review
WORKER_KEY=change-this-worker-key
VEHICLE_MODEL=/app/data/models/yolo11n.pt
PLATE_MODEL=
ENABLE_FACE=1
MAX_CAMERAS=4
# Optional: calibrated alert triage. Leave LAYA_API_KEY blank to use the
# deterministic triage scorer only (default; no external calls made).
LAYA_API_KEY=
LAYA_MODEL=laya-typed-decisions
LAYA_URL=http://localhost:8080/v1/choice
LAYA_TIMEOUT_S=0.5
# Optional: onboard real feeds from the external Sentinel Camera Grid
# (cctv.corp8.cloud). Leave blank to skip; requires access on that grid's
# approved-email list. Never commit real values here.
SENTINEL_GRID_EMAIL=
SENTINEL_GRID_PASSWORD=
SENTINEL_GRID_TRANSPORT=rtsp
SENTINEL_GRID_HTTP_BASE=https://cctv.corp8.cloud
SENTINEL_GRID_HOST=103.250.160.189
SENTINEL_GRID_RTSP_PORT=8554
SENTINEL_GRID_WHEP_PORT=8889
