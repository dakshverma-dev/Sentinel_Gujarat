DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel
POSTGRES_PASSWORD=sentinel
JWT_SECRET=change-this-before-exposing-the-app
DEMO_USER=operator
DEMO_PASSWORD=sentinel-demo
ADMIN_USER=admin
ADMIN_PASSWORD=sentinel-admin
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=sentinel-review
WORKER_KEY=change-this-worker-key
VEHICLE_MODEL=/app/data/models/yolo11n.pt
PLATE_MODEL=
ENABLE_FACE=1
MAX_CAMERAS=4
# Optional: calibrated alert triage. Leave JEV_API_KEY blank to use the
# deterministic triage scorer only (default; no external calls made).
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_URL=https://api.typesafe.ai/v1/choice
JEV_TIMEOUT_S=0.5
